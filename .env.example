# このファイルを .env という名前でコピーして、実際の値を入れてください。
#   cp .env.example .env
# .env は .gitignore で除外されており、コミットされません。

# --- Claude API (領収書の読み取りに使用) ---
# https://console.anthropic.com/ で発行した API キー
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- TeamSpirit ログイン情報 ---
# Salesforce(TeamSpirit)のログインID(メールアドレス等)とパスワード
TS_USERNAME=your-login-id@example.com
TS_PASSWORD=your-password

# TeamSpirit のログインURL(通常は会社のSalesforceログインページ)
# 経費申請画面: https://teamspirit-4739.lightning.force.com/lightning/n/teamspirit__AtkEmpExpTab
TS_LOGIN_URL=https://login.salesforce.com/
